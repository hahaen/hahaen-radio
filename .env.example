# Optional server runtime values. Empty entries use documented non-secret defaults.
# Copy to .env.local; loaded explicitly by the server dev/start commands.
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
API_DOCS_ENABLED=
# system by default; https uses verified Cloudflare DNS-over-HTTPS when system DNS returns Fake-IP.
REMOTE_DNS_MODE=

# Required only by database-backed entries. Never use the production database in development.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=
# required by default; disabled is permitted only for a loopback development/test connection.
DB_TLS=
DB_TLS_CA_PATH=

# Optional manual music recognition. Off by default; no calls without all fields and an initialized private quota.
RECOGNITION_ENABLED=
AUDD_API_TOKEN=
# Explicit maximum number of provider requests for this budget; no automatic replenishment.
RECOGNITION_REQUEST_LIMIT=
RECOGNITION_BUDGET_ID=
# Absolute path in a private persistent directory (700); state file must be 600.
RECOGNITION_STATE_PATH=

# Private maintenance only. Paths are absolute; backup directory must be owned and mode 700.
MYSQLDUMP_PATH=
MYSQL_PATH=
BACKUP_DIRECTORY=
# Optional byte limit; default 1GiB, explicitly configurable up to 100GiB.
BACKUP_MAX_BYTES=
# Set only after schema changes are excluded; pre-migration backups also require stopped writers.
BACKUP_SCHEMA_STABLE=
BACKUP_WRITES_STOPPED=

# Set true only after all writers have stopped, before running a migration.
MIGRATION_WRITES_STOPPED=

# Daily backup: private replica directory; production requires a different filesystem device.
BACKUP_REPLICA_DIRECTORY=
# Full deployed application commit, updated with each release.
BACKUP_APPLICATION_REVISION=

# First migration only: explicitly confirm the checked target is completely empty.
MIGRATION_INITIALIZE_EMPTY=

# Daily backups can read the active server revision from a private 600 file.
BACKUP_APPLICATION_REVISION_PATH=

# Target deployment: private absolute paths, no default production action.
HAEN_TARGET_CONFIG_FILE=
HAEN_RELEASE_FILE=
HAEN_REGISTRY_CONFIG_FILE=
HAEN_DEPLOY_ACTION=
HAEN_DEPLOY_SCOPE=
HAEN_CONTRACT_COMPATIBILITY_CONFIRMED=
HAEN_OTHER_WRITERS_STOPPED=
HAEN_BOOTSTRAP_CATALOG=
HAEN_BASELINE_REVISION=
HAEN_RECOVERY_CONFIRMED=
HAEN_RECOVERY_VERSION=
