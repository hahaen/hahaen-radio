{
  "name": "@haen/ld-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/prepare-sdk.mjs && vite",
    "typecheck": "node tools/prepare-sdk.mjs && tsc -p tsconfig.json",
    "build": "pnpm typecheck && vite build",
    "package": "node tools/package.mjs && pnpm build && node tools/package.mjs --write",
    "package:check": "pnpm build && node tools/package.mjs --check",
    "catalog:export": "node tools/export-catalog.mjs",
    "package:sandbox": "node tools/package.mjs --sandbox && pnpm build && node tools/package.mjs --sandbox --write",
    "test:package": "pnpm package:check && node tools/check-package.mjs"
  },
  "dependencies": {
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  }
}
