{
  "name": "@haen/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/entrypoints/api.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/entrypoints/api.js",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.check.json"
  },
  "dependencies": {
    "@haen/contracts": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  }
}
