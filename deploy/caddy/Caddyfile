{
	admin off
	http_port 8080
	https_port 8443
	# Access/error request logs can contain client addresses; operational probes provide status.
	log default {
		output discard
	}
}

http://127.0.0.1:8081 {
	bind 127.0.0.1
	root * {$HAEN_WEB_ROOT:/srv}
	route {
		@maintenanceProbe {
			path /maintenance
			file {
				root {$HAEN_MAINTENANCE_ROOT:/run/haen-maintenance}
				try_files enabled
			}
		}
		respond @maintenanceProbe "enabled" 200
		respond /maintenance "disabled" 200
		respond /health "ok" 200
		reverse_proxy /api/* api:3001
		rewrite /release /index.html
		file_server
	}
}

{$HAEN_SITE} {
	root * {$HAEN_WEB_ROOT:/srv}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	route {
		@maintenance file {
			root {$HAEN_MAINTENANCE_ROOT:/run/haen-maintenance}
			try_files enabled
		}
		handle @maintenance {
			header Cache-Control "no-store"
			header Retry-After "120"
			@apiMaintenance path /api /api/*
			handle @apiMaintenance {
				header Content-Type application/json
				respond `{"error":{"code":"MAINTENANCE","message":"Service temporarily unavailable"}}` 503
			}
			handle {
				rewrite * /maintenance.html
				file_server {
					status 503
				}
			}
		}
		@api path /api /api/*
		handle @api {
			header >Cache-Control "no-store"
			reverse_proxy api:3001
		}

		@static path /assets/* /fonts/* /geography/* /licenses/* /favicon.ico /favicon.svg /robots.txt
		handle @static {
			header Cache-Control "no-cache"
			@hashed {
				path /assets/*
				file {path}
			}
			header @hashed >Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@file path_regexp \.[^/]+$
		handle @file {
			header Cache-Control "no-cache"
			file_server
		}

		handle {
			@navigation {
				method GET HEAD
				header Accept *text/html*
			}
			rewrite @navigation /index.html
			header Cache-Control "no-cache"
			file_server
		}
	}
}
