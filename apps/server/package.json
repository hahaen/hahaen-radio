{
  "name": "@haen/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --import tsx --watch src/entrypoints/api.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/entrypoints/api.js",
    "build": "node ../../scripts/clean-dist.mjs && tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.check.json",
    "db:generate": "node --env-file-if-exists=../../.env.local node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=../../.env.migration.local --import tsx src/entrypoints/migrate.ts",
    "catalog": "node --env-file-if-exists=../../.env.jobs.local --import tsx src/entrypoints/catalog.ts",
    "jobs": "node --env-file-if-exists=../../.env.jobs.local --import tsx src/entrypoints/jobs.ts",
    "start:jobs": "node --env-file-if-exists=../../.env.jobs.local dist/entrypoints/jobs.js",
    "test:mysql": "node --env-file-if-exists=../../.env.migration.local --import tsx src/testing/run-mysql.ts",
    "places": "node --env-file-if-exists=../../.env.jobs.local --import tsx src/entrypoints/places.ts",
    "recognition:quota": "node --env-file-if-exists=../../.env.local --import tsx src/entrypoints/recognition-quota.ts",
    "diagnostics": "node --env-file-if-exists=../../.env.jobs.local --import tsx src/entrypoints/diagnostics.ts",
    "db:backup": "node --env-file-if-exists=../../.env.backup.local --import tsx src/entrypoints/backup.ts",
    "db:restore": "node --env-file-if-exists=../../.env.restore.local --import tsx src/entrypoints/backup.ts restore-isolated",
    "test:backup": "node --env-file-if-exists=../../.env.backup.local --import tsx src/testing/run-backup.ts",
    "deploy:target": "node --env-file=../../.env.deploy.local --import tsx src/entrypoints/deploy.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@haen/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "ipaddr.js": "2.5.0",
    "mysql2": "3.24.6",
    "node-cron": "4.6.0",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  },
  "files": [
    "dist"
  ]
}
