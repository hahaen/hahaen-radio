{
	admin off
	http_port 8080
	https_port 8443
	# Access/error request logs can contain client addresses; operational probes provide status.
	log default {
		output discard
	}
}

http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /health "ok" 200
}

{$HAEN_SITE} {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@api path /api /api/*
	handle @api {
		header >Cache-Control "no-store"
		reverse_proxy api:3001
	}

	@static path /assets/* /fonts/* /geography/* /licenses/* /favicon.ico /favicon.svg /robots.txt
	handle @static {
		header Cache-Control "no-cache"
		@hashed {
			path /assets/*
			file {path}
		}
		header @hashed >Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@file path_regexp \.[^/]+$
	handle @file {
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		@navigation {
			method GET HEAD
			header Accept *text/html*
		}
		rewrite @navigation /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
