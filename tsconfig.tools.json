{
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "playwright.performance.config.ts",
    "tests/performance/**/*.ts"
  ]
}
