# Copy to a private excluded file; absolute paths refer to the deployment host.
# Image references must identify one reviewed commit, preferably image@sha256:...
HAEN_WEB_IMAGE=
HAEN_SERVER_IMAGE=
HAEN_MIGRATION_IMAGE=
# Public DNS name for HTTPS; explicit http://... is for isolated validation only.
HAEN_SITE=
HAEN_WEB_BIND=
HAEN_HTTP_PORT=
HAEN_HTTPS_PORT=
# Each service has a separate least-privilege identity. These are paths, not file contents.
HAEN_API_ENV_FILE=
HAEN_JOBS_ENV_FILE=
HAEN_MIGRATION_ENV_FILE=
HAEN_DB_CA_FILE=
