{
  "name": "haen-radio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.9.0",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "dev": "pnpm --filter @haen/contracts build && pnpm --parallel --filter @haen/web --filter @haen/server dev",
    "dev:web": "pnpm --filter @haen/web dev",
    "dev:server": "pnpm --filter @haen/contracts build && pnpm --filter @haen/server dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,css,html,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,css,html,yaml}\"",
    "typecheck": "pnpm --filter @haen/contracts build && pnpm -r typecheck && tsc --project tsconfig.tools.json",
    "test": "pnpm --filter @haen/contracts build && vitest run",
    "test:coverage": "pnpm --filter @haen/contracts build && vitest run --coverage",
    "test:e2e": "pnpm --filter @haen/contracts build && playwright test",
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docs:check": "node scripts/check-docs.mjs",
    "db:generate": "pnpm --filter @haen/server db:generate",
    "db:migrate": "pnpm --filter @haen/server db:migrate",
    "test:mysql": "pnpm --filter @haen/contracts build && pnpm --filter @haen/server test:mysql",
    "catalog": "pnpm --filter @haen/contracts build && pnpm --filter @haen/server catalog",
    "jobs": "pnpm --filter @haen/contracts build && pnpm --filter @haen/server jobs",
    "places": "pnpm --filter @haen/contracts build && pnpm --filter @haen/server places",
    "recognition:quota": "pnpm --filter @haen/server recognition:quota"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
